# Postgres (Neon, Supabase, or `docker compose up -d`)
DATABASE_URL=postgres://dailydrop:dailydrop@localhost:5432/dailydrop

# Vercel AI Gateway
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5-mini

# Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="DailyDrop <drop@yourdomain.com>"

# Inngest: INNGEST_DEV=1 locally (with `npm run inngest:dev`); signing + event keys in production
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Signs the settings and unsubscribe links
LINK_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000
